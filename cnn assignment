        "# APTOS 2019 DATASET LOADING & PREPROCESSING\n",
        "# KAGGLE NOTEBOOK\n",
        "# ==========================================\n",
        "\n",
        "# 1. IMPORT LIBRARIES\n",
        "\n",
        "import os\n",
        "import glob\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import tensorflow as tf\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.utils.class_weight import compute_class_weight\n",
        "\n",
        "# ==========================================\n",
        "# 2. BASIC SETTINGS\n",
        "# ==========================================\n",
        "\n",
        "IMG_SIZE = 224\n",
        "BATCH_SIZE = 16\n",
        "EPOCHS = 5\n",
        "\n",
        "AUTOTUNE = tf.data.AUTOTUNE\n",
        "\n",
        "print(\"Image Size:\", IMG_SIZE, \"x\", IMG_SIZE)\n",
        "print(\"Batch Size:\", BATCH_SIZE)\n",
        "print(\"Epochs:\", EPOCHS)\n",
        "\n",
        "# ==========================================\n",
        "# 3. FIND DATASET PATH\n",
        "# ==========================================\n",
        "\n",
        "DATASET_PATH = \"/kaggle/input\"\n",
        "\n",
        "train_csv_files = glob.glob(\n",
        "    os.path.join(DATASET_PATH, \"**\", \"train.csv\"),\n",
        "    recursive=True\n",
        ")\n",
        "\n",
        "train_image_folders = glob.glob(\n",
        "    os.path.join(DATASET_PATH, \"**\", \"train_images\"),\n",
        "    recursive=True\n",
        ")\n",
        "\n",
        "if not train_csv_files or not train_image_folders:\n",
        "    raise FileNotFoundError(\n",
        "        \"APTOS dataset not found. Please add the competition \"\n",
        "        \"dataset using Kaggle's Add Input option.\"\n",
        "    )\n",
        "\n",
        "train_csv = train_csv_files[0]\n",
        "train_image_dir = train_image_folders[0]\n",
        "\n",
        "print(\"\\nDataset Found!\")\n",
        "print(\"CSV Path:\", train_csv)\n",
        "print(\"Image Folder:\", train_image_dir)\n",
        "\n",
        "# ==========================================\n",
        "# 4. LOAD TRAINING CSV\n",
        "# ==========================================\n",
        "\n",
        "train_df = pd.read_csv(train_csv)\n",
        "\n",
        "print(\"\\nTraining Data:\")\n",
        "print(train_df.head())\n",
        "\n",
        "print(\"\\nDataset Shape:\", train_df.shape)\n",
        "\n",
        "# ==========================================\n",
        "# 5. MATCH IMAGE PATHS WITH LABELS\n",
        "# ==========================================\n",
        "\n",
        "def get_image_path(image_id):\n",
        "\n",
        "    matches = glob.glob(\n",
        "        os.path.join(\n",
        "            train_image_dir,\n",
        "            str(image_id) + \".*\"\n",
        "        )\n",
        "    )\n",
        "\n",
        "    if not matches:\n",
        "        raise FileNotFoundError(\n",
        "            f\"Image not found: {image_id}\"\n",
        "        )\n",
        "\n",
        "    return matches[0]\n",
        "\n",
        "\n",
        "train_df[\"image_path\"] = train_df[\"id_code\"].apply(\n",
        "    get_image_path\n",
        ")\n",
        "\n",
        "print(\"\\nAll Image Paths Matched!\")\n",
        "\n",
        "# ==========================================\n",
        "# 6. TRAIN-VALIDATION SPLIT\n",
        "# ==========================================\n",
        "\n",
        "X_train, X_val, y_train, y_val = train_test_split(\n",
        "    train_df[\"image_path\"].values,\n",
        "    train_df[\"diagnosis\"].values,\n",
        "    test_size=0.20,\n",
        "    random_state=42,\n",
        "    stratify=train_df[\"diagnosis\"].values\n",
        ")\n",
        "\n",
        "print(\"\\nTraining Images:\", len(X_train))\n",
        "print(\"Validation Images:\", len(X_val))\n",
        "\n",
        "# ==========================================\n",
        "# 7. IMAGE PREPROCESSING\n",
        "# ==========================================\n",
        "\n",
        "def preprocess_image(image_path, label):\n",
        "\n",
        "    # Read image\n",
        "    image = tf.io.read_file(image_path)\n",
        "\n",
        "    # Decode image into RGB\n",
        "    image = tf.io.decode_image(\n",
        "        image,\n",
        "        channels=3,\n",
        "        expand_animations=False\n",
        "    )\n",
        "\n",
        "    image.set_shape([None, None, 3])\n",
        "\n",
        "    # Resize image\n",
        "    image = tf.image.resize(\n",
        "        image,\n",
        "        [IMG_SIZE, IMG_SIZE]\n",
        "    )\n",
        "\n",
        "    # Normalize pixel values\n",
        "    image = tf.cast(image, tf.float32) / 255.0\n",
        "\n",
        "    label = tf.cast(label, tf.int32)\n",
        "\n",
        "    return image, label\n",
        "\n",
        "# ==========================================\n",
        "# 8. CREATE TRAINING DATASET\n",
        "# ==========================================\n",
        "\n",
        "train_dataset = tf.data.Dataset.from_tensor_slices(\n",
        "    (X_train, y_train)\n",
        ")\n",
        "\n",
        "train_dataset = (\n",
        "    train_dataset\n",
        "    .shuffle(1000)\n",
        "    .map(preprocess_image, num_parallel_calls=AUTOTUNE)\n",
        "    .batch(BATCH_SIZE)\n",
        "    .prefetch(AUTOTUNE)\n",
        ")\n",
        "\n",
        "# ==========================================\n",
        "# 9. CREATE VALIDATION DATASET\n",
        "# ==========================================\n",
        "\n",
        "val_dataset = tf.data.Dataset.from_tensor_slices(\n",
        "    (X_val, y_val)\n",
        ")\n",
        "\n",
        "val_dataset = (\n",
        "    val_dataset\n",
        "    .map(preprocess_image, num_parallel_calls=AUTOTUNE)\n",
        "    .batch(BATCH_SIZE)\n",
        "    .prefetch(AUTOTUNE)\n",
        ")\n",
        "\n",
        "# ==========================================\n",
        "# 10. CLASS NAMES\n",
        "# ==========================================\n",
        "\n",
        "class_names = [\n",
        "    \"No DR\",\n",
        "    \"Mild\",\n",
        "    \"Moderate\",\n",
        "    \"Severe\",\n",
        "    \"Proliferative DR\"\n",
        "]\n",
        "\n",
        "NUM_CLASSES = len(class_names)\n",
        "\n",
        "# ==========================================\n",
        "# 11. HANDLE CLASS IMBALANCE\n",
        "# ==========================================\n",
        "\n",
        "classes = np.unique(y_train)\n",
        "\n",
        "weights = compute_class_weight(\n",
        "    class_weight=\"balanced\",\n",
        "    classes=classes,\n",
        "    y=y_train\n",
        ")\n",
        "\n",
        "class_weights = {\n",
        "    int(c): float(w)\n",
        "    for c, w in zip(classes, weights)\n",
        "}\n",
        "\n",
        "# ==========================================\n",
        "# 12. DISPLAY SAMPLE IMAGES\n",
        "# ==========================================\n",
        "\n",
        "images, labels = next(iter(train_dataset))\n",
        "\n",
        "plt.figure(figsize=(10, 8))\n",
        "\n",
        "for i in range(min(9, len(images))):\n",
        "\n",
        "    plt.subplot(3, 3, i + 1)\n",
        "\n",
        "    plt.imshow(images[i].numpy())\n",
        "\n",
        "    plt.title(\n",
        "        class_names[int(labels[i].numpy())]\n",
        "    )\n",
        "\n",
        "    plt.axis(\"off\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# ==========================================\n",
        "# 13. FINAL DATASET INFORMATION\n",
        "# ==========================================\n",
        "\n",
        "print(\"\\n========== DATASET READY ==========\")\n",
        "\n",
        "print(\"Image Shape:\", (IMG_SIZE, IMG_SIZE, 3))\n",
        "print(\"Batch Size:\", BATCH_SIZE)\n",
        "print(\"Epochs:\", EPOCHS)\n",
        "print(\"Number of Classes:\", NUM_CLASSES)\n",
        "\n",
        "print(\"Training Batches:\", len(train_dataset))\n",
        "print(\"Validation Batches:\", len(val_dataset))\n",
        "\n",
        "print(\"\\nClass Weights:\", class_weights)\n",
        "\n",
        "print(\"\\nDataset Loading & Preprocessing Completed!\")\n"
