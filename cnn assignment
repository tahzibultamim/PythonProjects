        "\n",
        "# ============================================\n",
        "# SIMPLE CNN: 3 MODELS COMPARISON\n",
        "# A: 3x3 + MaxPooling\n",
        "# B: 5x5 + MaxPooling\n",
        "# C: 3x3 + AveragePooling\n",
        "# ============================================\n",
        "\n",
        "# 1. BASIC SETTINGS\n",
        "\n",
        "# 1. BASIC SETTINGS\n",
        "\n",
        "IMG_SIZE = 224\n",
        "BATCH_SIZE = 16\n",
        "EPOCHS = 5\n",
        "\n",
        "IMG_SHAPE = (IMG_SIZE, IMG_SIZE, 3)\n",
        "NUM_CLASSES = len(class_names)\n",
        "\n",
        "print(\"Image Size:\", IMG_SIZE, \"x\", IMG_SIZE)\n",
        "print(\"Batch Size:\", BATCH_SIZE)\n",
        "print(\"Epochs:\", EPOCHS)\n",
        "print(\"Image Shape:\", IMG_SHAPE)\n",
        "print(\"Number of Classes:\", NUM_CLASSES)\n",
        "\n",
        "\n",
        "# 2. CNN MODEL FUNCTION\n",
        "\n",
        "def build_cnn(kernel_size, pool_type):\n",
        "\n",
        "    model = tf.keras.Sequential([\n",
        "\n",
        "        tf.keras.layers.Input(shape=IMG_SHAPE),\n",
        "\n",
        "        # Data Augmentation\n",
        "        tf.keras.layers.RandomFlip(\"horizontal\"),\n",
        "        tf.keras.layers.RandomRotation(0.05),\n",
        "        tf.keras.layers.RandomZoom(0.1),\n",
        "\n",
        "        # Convolution Layer\n",
        "        tf.keras.layers.Conv2D(\n",
        "            filters=32,\n",
        "            kernel_size=kernel_size,\n",
        "            strides=1,\n",
        "            padding='same',\n",
        "            activation='relu'\n",
        "        ),\n",
        "\n",
        "        # Pooling Layer\n",
        "        pool_type(\n",
        "            pool_size=(2, 2),\n",
        "            strides=2,\n",
        "            padding='valid'\n",
        "        ),\n",
        "\n",
        "        # Flatten Layer\n",
        "        tf.keras.layers.Flatten(),\n",
        "\n",
        "        # Dense Layer\n",
        "        tf.keras.layers.Dense(\n",
        "            128,\n",
        "            activation='relu'\n",
        "        ),\n",
        "\n",
        "        # Dropout\n",
        "        tf.keras.layers.Dropout(0.4),\n",
        "\n",
        "        # Output Layer\n",
        "        tf.keras.layers.Dense(\n",
        "            NUM_CLASSES,\n",
        "            activation='softmax'\n",
        "        )\n",
        "    ])\n",
        "\n",
        "    # Compile Model\n",
        "    model.compile(\n",
        "        optimizer='adam',\n",
        "        loss='sparse_categorical_crossentropy',\n",
        "        metrics=['accuracy']\n",
        "    )\n",
        "\n",
        "    return model\n",
        "\n",
        "\n",
        "# 3. DEFINE THREE MODELS\n",
        "\n",
        "model_configs = {\n",
        "\n",
        "    'Model A (3x3 MaxPool)': {\n",
        "        'kernel': (3, 3),\n",
        "        'pool': tf.keras.layers.MaxPooling2D\n",
        "    },\n",
        "\n",
        "    'Model B (5x5 MaxPool)': {\n",
        "        'kernel': (5, 5),\n",
        "        'pool': tf.keras.layers.MaxPooling2D\n",
        "    },\n",
        "\n",
        "    'Model C (3x3 AvgPool)': {\n",
        "        'kernel': (3, 3),\n",
        "        'pool': tf.keras.layers.AveragePooling2D\n",
        "    }\n",
        "}\n",
        "\n",
        "\n",
        "# 4. TRAIN ALL THREE MODELS\n",
        "\n",
        "models = {}\n",
        "histories = {}\n",
        "\n",
        "for name, config in model_configs.items():\n",
        "\n",
        "    print(\"\\n==============================\")\n",
        "    print(\"Training:\", name)\n",
        "    print(\"==============================\")\n",
        "\n",
        "    model = build_cnn(\n",
        "        kernel_size=config['kernel'],\n",
        "        pool_type=config['pool']\n",
        "    )\n",
        "\n",
        "    model.summary()\n",
        "\n",
        "    # Training Callbacks\n",
        "    callbacks = [\n",
        "\n",
        "        tf.keras.callbacks.EarlyStopping(\n",
        "            monitor='val_loss',\n",
        "            patience=5,\n",
        "            restore_best_weights=True\n",
        "        ),\n",
        "\n",
        "        tf.keras.callbacks.ReduceLROnPlateau(\n",
        "            monitor='val_loss',\n",
        "            factor=0.5,\n",
        "            patience=2,\n",
        "            min_lr=0.000001\n",
        "        )\n",
        "    ]\n",
        "\n",
        "    history = model.fit(\n",
        "        train_dataset,\n",
        "        validation_data=val_dataset,\n",
        "        epochs=EPOCHS,\n",
        "        class_weight=class_weights,\n",
        "        callbacks=callbacks\n",
        "    )\n",
        "\n",
        "    models[name] = model\n",
        "    histories[name] = history\n",
        "\n",
        "\n",
        "# 5. PLOT ACCURACY\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "\n",
        "for name, history in histories.items():\n",
        "\n",
        "    plt.plot(\n",
        "        history.history['accuracy'],\n",
        "        label=name + ' - Train'\n",
        "    )\n",
        "\n",
        "    plt.plot(\n",
        "        history.history['val_accuracy'],\n",
        "        linestyle='--',\n",
        "        label=name + ' - Validation'\n",
        "    )\n",
        "\n",
        "plt.title('CNN Models - Accuracy Comparison')\n",
        "plt.xlabel('Epochs')\n",
        "plt.ylabel('Accuracy')\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# 6. PLOT LOSS\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "\n",
        "for name, history in histories.items():\n",
        "\n",
        "    plt.plot(\n",
        "        history.history['loss'],\n",
        "        label=name + ' - Train'\n",
        "    )\n",
        "\n",
        "    plt.plot(\n",
        "        history.history['val_loss'],\n",
        "        linestyle='--',\n",
        "        label=name + ' - Validation'\n",
        "    )\n",
        "\n",
        "plt.title('CNN Models - Loss Comparison')\n",
        "plt.xlabel('Epochs')\n",
        "plt.ylabel('Loss')\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# 7. FINAL MODEL COMPARISON\n",
        "\n",
        "print(\"\\n========== MODEL COMPARISON ==========\")\n",
        "\n",
        "for name, history in histories.items():\n",
        "\n",
        "    best_accuracy = max(history.history['val_accuracy'])\n",
        "    best_loss = min(history.history['val_loss'])\n",
        "\n",
        "    print(\"\\n\", name)\n",
        "\n",
        "    print(\n",
        "        \"Best Validation Accuracy:\",\n",
        "        round(best_accuracy * 100, 2), \"%\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"Lowest Validation Loss:\",\n",
        "        round(best_loss, 4)\n",
        "    )\n",
        "\n",
        "print(\"\\nAll three CNN models trained successfully!\")\n"
